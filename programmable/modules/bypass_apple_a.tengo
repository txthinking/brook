// Bypass Apple with A, if your local does not support ipv6

modules = append(modules, {
    address: func(m) {
        if m.domainaddress {
            brook := import("brook")
            hp := brook.splithostport(m.domainaddress)
            if is_error(hp) {
                return hp
            }
            text := import("text")
            f := func(domain, l){
                ss := text.split(text.to_lower(domain), ".")
                s := ""
                for i := len(ss) - 1; i >= 0; i-- {
                    if s == "" {
                        s = ss[i]
                    } else {
                        s = ss[i] + "." + s
                    }
                    if l[s] {
                        return { ipaddressfrombypassdns: "A", bypass: true }
                    }
                }
            }
            l := {
            "apple.com",
            "icloud.com",
            "cdn-apple.com",
            "mzstatic.com",
            "entrust.net",
            "digicert.com",
            "verisign.net",
            "apple",
            "akadns.net",
            "ks-cdn.com",
            "ksyuncdn.com",
            "edgekey.net",
            "akamaiedge.net",
            "ioshost.qtlcdn.com"
            }
            r := f(hp.host, l)
            if r != undefined {
                return r
            }
        }
	if m.ipaddress {
            brook := import("brook")
            r := brook.splithostport(m.ipaddress)
            if is_error(r) {
                return r
            }
            l := [
                "17.0.0.0/8",
                "103.81.148.0/22",
                "103.81.148.0/24",
                "103.81.149.0/24",
                "2620:149:a44::/48",
                "2403:300:a42::/48",
                "2403:300:a51::/48",
                "2a01:b740:a42::/48"
            ]
            for v in l {
                if brook.cidrcontainsip(v, r.host) {
                    return { bypass: true }
                }
            }
        }
    }
})

