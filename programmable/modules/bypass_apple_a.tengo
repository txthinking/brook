// Bypass Apple with A, if your local does not support ipv6

modules = append(modules, {
    address: func(m) {
        if m.domainaddress {
            brook := import("brook")
            hp := brook.splithostport(m.domainaddress)
            if is_error(hp) {
                return hp
            }
            text := import("text")
            // but do not bypass push
            if hp.host == "push.apple.com" || text.has_suffix(hp.host, ".push.apple.com") {
                return
            }
            f := func(domain, l){
                ss := text.split(text.to_lower(domain), ".")
                s := ""
                for i := len(ss) - 1; i >= 0; i-- {
                    if s == "" {
                        s = ss[i]
                    } else {
                        s = ss[i] + "." + s
                    }
                    if l[s] {
                        return { ipaddressfrombypassdns: "A", bypass: true }
                    }
                }
            }
            l := {
                "apple.com": true,
                "icloud.com": true,
                "cdn-apple.com": true,
                "mzstatic.com": true,
                "entrust.net": true,
                "digicert.com": true,
                "verisign.net": true,
                "apple": true,
                "akadns.net": true,
                "ks-cdn.com": true,
                "ksyuncdn.com": true,
                "edgekey.net": true,
                "akamaiedge.net": true,
                "ioshost.qtlcdn.com": true
            }
            r := f(hp.host, l)
            if r != undefined {
                return r
            }
        }
        if m.ipaddress {
            brook := import("brook")
            r := brook.splithostport(m.ipaddress)
            if is_error(r) {
                return r
            }
            // but do not bypass push
            l := [
                "17.249.0.0/16",
                "17.252.0.0/16",
                "17.57.144.0/22",
                "17.188.128.0/18",
                "17.188.20.0/23",
                "2620:149:a44::/48",
                "2403:300:a42::/48",
                "2403:300:a51::/48",
                "2a01:b740:a42::/48"
            ]
            for v in l {
                if brook.cidrcontainsip(v, r.host) {
                    return
                }
            }
            l = [
                "17.0.0.0/8",
                "103.81.148.0/22",
                "103.81.148.0/24",
                "103.81.149.0/24",
                "2620:149:a44::/48",
                "2403:300:a42::/48",
                "2403:300:a51::/48",
                "2a01:b740:a42::/48"
            ]
            for v in l {
                if brook.cidrcontainsip(v, r.host) {
                    return { bypass: true }
                }
            }
        }
    }
})

